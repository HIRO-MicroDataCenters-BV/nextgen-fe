# NextGen-FE environment template — COMMITTED, so never put secrets here.
# Copy it to one of the two gitignored files:
#   .env.local       → npm run dev       (local kind cluster)
#   .env             → npm run dev:prod  (real develop cluster)
# Values below are the HUS site, as the HUS website uses them (ds-gitops
# hus-services/frontend-dev/values.yaml). For the local kind cluster use
# http://<service>.hus.localhost instead (see the comments per section).

# ── Public (exposed to the browser via runtimeConfig.public) ────────────

# Search service (distributed/local catalog search)
NUXT_PUBLIC_API_SEARCH_SERVICE_URL=https://ds-gateway.hus.nextgen.hiro-develop.nl/search

# Catalog service (datasets CRUD, filters, MMIO upload)
NUXT_PUBLIC_API_CATALOG_SERVICE_URL=https://ds-gateway.hus.nextgen.hiro-develop.nl/catalog

# Connector service (related data products, connector metadata). Base URL only:
# the app adds /dataproducts/<id> itself.
NUXT_PUBLIC_API_CONNECTOR_SERVICE_URL=https://ds-connector.hus.nextgen.hiro-develop.nl

# Catalog slug used by the search/catalog APIs
NUXT_PUBLIC_CATALOG_NAME=hus_catalog

# Marketplace checkout (used server-side by /api/marketplace/checkout)
NUXT_PUBLIC_API_CHECKOUT_SERVICE_URL=https://ds-checkout.marketplace.nextgen.hiro-develop.nl

# COG (Connector-on-Graph) — UI redirect + API base for training pipeline submission
NUXT_PUBLIC_COG_URL=https://dashboard.cog.hiro-develop.nl/uidev/
NUXT_PUBLIC_API_COG_URL=https://dashboard.cog.hiro-develop.nl/apidev

# Training builder service
# NOTE: nuxt.config.ts expects NUXT_PUBLIC_TRAINING_BUILDER_SERVICE_URL,
# but the Helm chart currently sets NUXT_PUBLIC_API_TRAINING_BUILDER_URL.
# Using the name nuxt.config actually reads.
NUXT_PUBLIC_TRAINING_BUILDER_SERVICE_URL=https://dashboard.cog.hiro-develop.nl/apidev

# DKMS key-file sign-in (ds-login) and the Credentials page (credential
# issuer). The browser calls both directly, like catalog and search (they allow
# every website: CORS "*"). Empty ds-login URL = sign-in off.
# kind: http://ds-login.hus.localhost and http://ds-credential-issuer.hus.localhost
# Sign-in files: a key file (dkms identifier export) + its credential grant.
NUXT_PUBLIC_DS_LOGIN_URL=https://ds-login.hus.nextgen.hiro-develop.nl
NUXT_PUBLIC_API_CREDENTIAL_ISSUER_URL=https://ds-credential-issuer.hus.nextgen.hiro-develop.nl
# A public DKMS witness the Credentials page checks the issuer against.
# Empty = check skipped (the HUS and kind witnesses are not public).
NUXT_PUBLIC_DKMS_WITNESS_URL=

# ── Server-only (Dex auth — NEVER exposed to the browser) ───────────────
# Fill these in from your Dex deployment / 1Password / team secrets store.
# Without these, login flows that hit the Nuxt /server proxy will fail.

NUXT_DEX_HOST=
NUXT_DEX_LOGIN=
NUXT_DEX_PASSWORD=
NUXT_DEX_AUTH_TYPE=local
# Set to "false" to enforce TLS verification against Dex (default: skip).
NUXT_DEX_SKIP_TLS_VERIFY=true

# ── Optional ────────────────────────────────────────────────────────────
# Surfaced in the UI footer / about page.
NUXT_PUBLIC_APP_VERSION=1.0.0-dev


NUXT_CLEARING_HOUSE_URL=http://localhost:8085
NUXT_ADMIN_EMAILS=admin@hiro.com
NUXT_ALLOW_DEV_ADMIN_AUTH=true
